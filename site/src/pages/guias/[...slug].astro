---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { familiaDe } from '../../familias';

// Genera una ruta por cada guía de la colección
export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map(guia => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);

const comoTexto = f => f.toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const familia = familiaDe(guia.data.familia);
const fechaTexto = comoTexto(guia.data.fecha);
const actualizadoTexto = guia.data.actualizado ? comoTexto(guia.data.actualizado) : null;
---

<Base title={`${guia.data.titulo} · Pick&Stats`} description={guia.data.descripcionSeo} tipo="article"
  publicado={guia.data.fecha.toISOString()}
  modificado={(guia.data.actualizado ?? guia.data.fecha).toISOString()}>
  <article>
    <p class="volver">
      <a href="/guias/">← Guías</a> · <a href={`/guias/#${familia.clave}`}>{familia.titulo}</a>
    </p>
    <h1>{guia.data.titulo}</h1>
    <p class="meta">
      Publicado el {fechaTexto}
      {actualizadoTexto && <> · <strong>Actualizado el {actualizadoTexto}</strong></>}
    </p>
    {guia.data.temporada && (
      <p class="datos">
        Los ejemplos de esta guía usan datos de la temporada <strong>{guia.data.temporada}</strong>.
        Las cifras no se refrescan cada año: ilustran cómo se lee la métrica, no el estado
        de la temporada en curso.
      </p>
    )}
    <Content />
  </article>

  <style>
    .volver { font-size: 14px; }
    .meta { color: var(--tinta-suave); font-size: 14px; margin-top: -8px; }
    .datos {
      color: var(--tinta-suave);
      font-size: 14px;
      line-height: 1.6;
      background: var(--panel);
      border-left: 3px solid var(--linea);
      border-radius: 0 var(--radio) var(--radio) 0;
      padding: 10px 14px;
      margin: 18px 0 24px;
    }
    article :global(h2) { margin-top: 32px; }
    article :global(ul) { padding-left: 20px; }
    article :global(li) { margin-bottom: 6px; }

    /* Bloques de fórmulas: legibles y con scroll propio en móvil */
    article :global(pre) {
      background: #f4f6f9;
      border: 1px solid var(--linea);
      border-left: 3px solid var(--acento);
      border-radius: var(--radio);
      padding: 14px 16px;
      overflow-x: auto;
      font-size: 14px;
      line-height: 1.7;
      margin: 18px 0;
    }
    article :global(code) {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    /* Código suelto dentro de un párrafo */
    article :global(p code) {
      background: #f4f6f9;
      border: 1px solid var(--linea);
      border-radius: 4px;
      padding: 1px 5px;
      font-size: 13px;
    }
    article :global(pre code) { background: none; border: 0; padding: 0; }

    /* Tablas de las guías */
    article :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 18px 0;
      font-size: 15px;
      display: block;
      overflow-x: auto;
    }
    article :global(th) {
      background: var(--tinta);
      color: #fff;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: .5px;
      padding: 8px 10px;
      text-align: left;
      white-space: nowrap;
    }
    article :global(td) {
      padding: 8px 10px;
      border-bottom: 1px solid var(--linea);
    }
    article :global(tbody tr:nth-child(even)) { background: #fafbfc; }
  </style>
</Base>
