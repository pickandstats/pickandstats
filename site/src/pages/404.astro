---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada · Pick&Stats"
  description="La página que buscas no existe o ha cambiado de dirección.">
  <script is:inline>
  (function () {
    var ruta = location.pathname + location.search + location.hash;
    if (ruta.indexOf('/app/') === 0 && ruta !== '/app/') {
      // Ruta interna de la aplicación: la SPA la restaurará desde ?redir
      location.replace('/app/?redir=' + encodeURIComponent(ruta));
    }
  })();
</script>
  <section class="error404">
    <p class="codigo">404</p>
    <h1>Esta página no existe</h1>
    <p class="explica">
      El enlace que has seguido puede estar roto, o la página haber cambiado de dirección.
      No te preocupes, desde aquí vuelves al camino.
    </p>
    <div class="acciones">
      <a class="boton boton-primario" href="/">Ir al inicio</a>
      <a class="boton boton-secundario" href="/guias/">Ver las guías</a>
    </div>
    <p class="extra">
      ¿Buscabas estadísticas? Están en <a href="/app/">la aplicación</a>.
    </p>
  </section>

  <style>
    .error404 { text-align: center; max-width: 560px; margin: 0 auto; padding: 24px 0; }
    .codigo {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 96px; font-weight: 700; line-height: 1;
      color: var(--acento); margin: 0;
    }
    .error404 h1 { margin: 8px 0 16px; }
    .explica { color: var(--tinta-suave); font-size: 17px; line-height: 1.6; }
    .acciones { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 24px; }
    .boton {
      font-family: 'Barlow Condensed', sans-serif; font-size: 17px; font-weight: 600;
      text-transform: uppercase; letter-spacing: .3px;
      padding: 11px 26px; border-radius: var(--radio); text-decoration: none; display: inline-block;
    }
    .boton-primario { background: var(--acento); color: #fff; }
    .boton-primario:hover { opacity: .9; }
    .boton-secundario { background: transparent; color: var(--tinta); border: 1px solid var(--linea); }
    .boton-secundario:hover { border-color: var(--acento); color: var(--acento); }
    .extra { margin-top: 28px; font-size: 15px; color: var(--tinta-suave); }
  </style>
</Base>
